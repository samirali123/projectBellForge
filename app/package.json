{
  "name": "bellforge-app",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop launcher for the CyberData bell schedule automation",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "build": {
    "appId": "com.bellforge.app",
    "productName": "BellForge",
    "directories": {
      "output": "dist"
    },
    "files": ["**/*", "!dist/**"],
    "extraResources": [
      {
        "from": "../engine",
        "to": "engine",
        "filter": ["**/*", "!PROJECT_SPEC.md", "!README.md"]
      },
      {
        "from": "../schools",
        "to": "schools"
      }
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.education"
    },
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
